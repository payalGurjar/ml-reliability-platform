# ---------------------------------------------------------------------------
# DriftWatch — ML Reliability Platform
# Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Supabase (database + authentication) ----------------------------------
# Server-side (API routes). The service-role key must NEVER be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client-side (Vite). Only ever the public anon key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Google sign-in (optional) ---------------------------------------------
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# --- AI analysis provider (optional) ---------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. When unset, the platform
# uses its built-in deterministic statistical reasoner, so the AI feature keeps
# working with zero external dependencies.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Self-hosted Postgres (docker-compose only) -----------------------------
POSTGRES_USER=driftwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=driftwatch
POSTGRES_PORT=5432
